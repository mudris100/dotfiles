# Theme: Amber
set-window-option -g window-status-current-style bold,bg=colour214,fg=colour234
set-window-option -g window-status-style fg=colour214
set -g window-status-activity-style bold,bg=colour202,fg=colour234
set-option -g message-style bg=colour235,fg=colour222
set-option -g pane-border-style fg=colour130
set-option -g pane-active-border-style fg=colour214

# Status Bar
set -g status-justify centre
set -g status-bg colour234
set -g status-fg colour214
set -g status-interval 60
set -g status-left-length 50
set -g status-left "#[bg=colour214,fg=colour234] #[fg=colour234,bold]#H #[fg=colour234] [#S]"
set -g status-right "#[bg=colour214,fg=colour234] ⏰ #[fg=colour234,bold]%H:%M "


